{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.dev/schemas/actuation.agency-v1.schema.json",
  "title": "Actuation world-bound Agency contract",
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "schema": { "const": "actuation.agency/v1" },
    "worldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "binding_ref", "agent_ref", "agency_ref", "world_ref", "scope_ref"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema" },
        "binding_ref": { "$ref": "#/$defs/ref" },
        "agent_ref": { "$ref": "#/$defs/ref" },
        "agency_ref": { "$ref": "#/$defs/ref" },
        "world_ref": { "$ref": "#/$defs/ref" },
        "scope_ref": { "$ref": "#/$defs/ref" },
        "purpose_ref": { "$ref": "#/$defs/ref" },
        "continuity_ref": { "$ref": "#/$defs/ref" },
        "determining_agency_ref": { "$ref": "#/$defs/ref" },
        "return_relation_ref": { "$ref": "#/$defs/ref" },
        "bounds_refs": { "$ref": "#/$defs/refs" },
        "authority_refs": { "$ref": "#/$defs/refs" },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "human_authored_refs": { "$ref": "#/$defs/refs" },
            "security_policy_refs": { "$ref": "#/$defs/refs" },
            "evidence_refs": { "$ref": "#/$defs/refs" },
            "external_reality_refs": { "$ref": "#/$defs/refs" }
          }
        }
      }
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "determination_ref", "kind", "determining_agency_ref", "differentiated_agency_ref", "world_binding_ref", "bounds_refs", "delegated_autonomy", "return_policy"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema" },
        "determination_ref": { "$ref": "#/$defs/ref" },
        "kind": { "enum": ["self-differentiation", "delegation", "derivation", "federation"] },
        "determining_agency_ref": { "$ref": "#/$defs/ref" },
        "differentiated_agency_ref": { "$ref": "#/$defs/ref" },
        "world_binding_ref": { "$ref": "#/$defs/ref" },
        "parent_determination_ref": { "$ref": "#/$defs/ref" },
        "bounds_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "authority_refs": { "$ref": "#/$defs/refs" },
        "delegated_autonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["may_determine_within_bounds"],
          "properties": {
            "allowed_action_refs": { "$ref": "#/$defs/refs" },
            "denied_action_refs": { "$ref": "#/$defs/refs" },
            "may_determine_within_bounds": { "type": "boolean" }
          }
        },
        "return_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["required", "optional", "autonomous-termination"] },
            "return_relation_ref": { "$ref": "#/$defs/ref" }
          }
        }
      }
    },
    "return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "return_ref", "determination_ref", "from_agency_ref", "to_agency_ref", "difference_refs", "provenance", "received", "recognition_state", "world_mutation_state"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema" },
        "return_ref": { "$ref": "#/$defs/ref" },
        "determination_ref": { "$ref": "#/$defs/ref" },
        "from_agency_ref": { "$ref": "#/$defs/ref" },
        "to_agency_ref": { "$ref": "#/$defs/ref" },
        "difference_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "artifact_refs": { "$ref": "#/$defs/refs" },
        "claim_refs": { "$ref": "#/$defs/refs" },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agency_lineage_refs"],
          "properties": {
            "agency_lineage_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
            "material_refs": { "$ref": "#/$defs/refs" },
            "external_source_refs": { "$ref": "#/$defs/refs" }
          }
        },
        "received": { "type": "boolean" },
        "recognition_state": { "enum": ["pending", "recognised", "rejected"] },
        "world_mutation_state": { "enum": ["not-applied", "applied"] }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/worldBinding" },
    { "$ref": "#/$defs/determination" },
    { "$ref": "#/$defs/return" }
  ]
}
