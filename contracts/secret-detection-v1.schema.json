{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.github.io/actuation/contracts/secret-detection-v1.schema.json",
  "title": "Actuation secret-detection contract v1",
  "description": "Detection-first secret-source ground, actuation.secret-detection/v1. A descriptor declares a probeable secret source; a scan proves it live. Evidence is fingerprint-only (SHA-256) — a detector that can emit a value is itself a leak source, so value-shaped keys are unrepresentable anywhere in a scan record. Violations carry a class and a centralise_to ref; unavailable carries a mandatory reason and never reads as absence.",
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceKind": {
      "enum": [
        "op-item",
        "keychain-entry",
        "varlock-blob",
        "env-var",
        "plaintext-file"
      ]
    },
    "probeKind": {
      "enum": [
        "env",
        "file-pattern",
        "cli-presence",
        "vault-item"
      ]
    },
    "scanState": {
      "enum": [
        "verified",
        "violation",
        "absent",
        "unavailable"
      ]
    },
    "probeResult": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "violationClass": {
      "enum": [
        "stray-plaintext",
        "uncentralised-env",
        "legacy-env-ref",
        "unknown"
      ]
    },
    "probe": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/probeKind" },
        "result": { "$ref": "#/$defs/probeResult" },
        "spec": { "$ref": "#/$defs/ref" },
        "detail": { "$ref": "#/$defs/ref" }
      },
      "required": [
        "kind",
        "result"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "where": { "$ref": "#/$defs/ref" },
        "fingerprint_sha256": { "$ref": "#/$defs/fingerprint" },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "where",
        "fingerprint_sha256"
      ],
      "additionalProperties": false
    },
    "descriptorProbeSpec": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "properties": {
            "names": {
              "type": "array",
              "items": { "$ref": "#/$defs/ref" }
            },
            "name_pattern": { "$ref": "#/$defs/ref" }
          },
          "additionalProperties": false
        },
        "file-pattern": {
          "type": "object",
          "properties": {
            "patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/ref" }
            },
            "roots": {
              "type": "array",
              "items": { "$ref": "#/$defs/ref" }
            }
          },
          "required": [
            "patterns"
          ],
          "additionalProperties": false
        },
        "cli-presence": {
          "type": "object",
          "properties": {
            "names": {
              "type": "array",
              "items": { "$ref": "#/$defs/ref" }
            }
          },
          "required": [
            "names"
          ],
          "additionalProperties": false
        },
        "vault-item": {
          "type": "object",
          "properties": {
            "item_ref": { "$ref": "#/$defs/ref" }
          },
          "required": [
            "item_ref"
          ],
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authored_by": { "$ref": "#/$defs/ref" },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "accepted_by": { "$ref": "#/$defs/ref" },
        "catalog_revision": {
          "type": "integer"
        }
      },
      "required": [
        "authored_by",
        "catalog_revision"
      ],
      "additionalProperties": false
    },
    "secretSourceDescriptor": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "actuation.secret-detection/v1"
        },
        "document": {
          "const": "descriptor"
        },
        "slug": { "$ref": "#/$defs/ref" },
        "source_kind": { "$ref": "#/$defs/sourceKind" },
        "ref_schemes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "probe": { "$ref": "#/$defs/descriptorProbeSpec" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "required": [
        "schema",
        "document",
        "slug",
        "source_kind",
        "ref_schemes",
        "probe",
        "provenance"
      ],
      "additionalProperties": false
    },
    "scanEntry": {
      "type": "object",
      "properties": {
        "slug": { "$ref": "#/$defs/ref" },
        "source_ref": { "$ref": "#/$defs/ref" },
        "state": { "$ref": "#/$defs/scanState" },
        "unavailable_reason": { "$ref": "#/$defs/ref" },
        "violation_class": { "$ref": "#/$defs/violationClass" },
        "centralise_to": { "$ref": "#/$defs/ref" },
        "probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/probe" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "required": [
        "slug",
        "source_ref",
        "state"
      ],
      "additionalProperties": false
    },
    "secretScan": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "actuation.secret-detection/v1"
        },
        "document": {
          "const": "scan"
        },
        "scan_ref": { "$ref": "#/$defs/ref" },
        "observed_at": { "$ref": "#/$defs/ref" },
        "catalog_revision": {
          "type": "integer"
        },
        "scanner": {
          "type": "object",
          "properties": {
            "implementation": { "$ref": "#/$defs/ref" },
            "version": { "$ref": "#/$defs/ref" }
          },
          "required": [
            "implementation",
            "version"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/scanEntry" }
        },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "coverage": {
          "enum": [
            "complete",
            "partial"
        ]
        },
        "disclosure": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        }
      },
      "required": [
        "schema",
        "document",
        "scan_ref",
        "observed_at",
        "catalog_revision",
        "scanner",
        "sources",
        "violations",
        "coverage"
      ],
      "additionalProperties": false
    },
    "secretSourceCatalog": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "actuation.secret-detection/v1"
        },
        "document": {
          "const": "catalog"
        },
        "catalog_revision": {
          "type": "integer"
        },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/secretSourceDescriptor" }
        }
      },
      "required": [
        "schema",
        "document",
        "catalog_revision",
        "descriptors"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/secretSourceDescriptor" },
    { "$ref": "#/$defs/secretScan" },
    { "$ref": "#/$defs/secretSourceCatalog" }
  ]
}
