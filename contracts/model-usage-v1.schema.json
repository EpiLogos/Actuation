{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epilogos.dev/contracts/model-usage-v1.schema.json",
  "title": "Actuation model-usage observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "usage_ref", "actuation_ref", "invocation_ref", "correlation", "provider", "model", "tokens", "cache", "timing", "cost", "outcome", "provenance"],
  "properties": {
    "schema": { "const": "actuation.model-usage/v1" },
    "usage_ref": { "$ref": "#/$defs/ref" },
    "actuation_ref": { "$ref": "#/$defs/ref" },
    "invocation_ref": { "$ref": "#/$defs/ref" },
    "correlation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "activity_ref": { "$ref": "#/$defs/ref" }, "agent_ref": { "$ref": "#/$defs/ref" },
        "agency_ref": { "$ref": "#/$defs/ref" }, "agent_session_ref": { "$ref": "#/$defs/ref" },
        "harness_ref": { "$ref": "#/$defs/ref" }, "body_ref": { "$ref": "#/$defs/ref" },
        "native_session_ref": { "$ref": "#/$defs/ref" }, "external_refs": { "$ref": "#/$defs/refs" }
      }
    },
    "provider": { "$ref": "#/$defs/identity" },
    "model": { "$ref": "#/$defs/identity" },
    "tokens": {
      "type": "object", "additionalProperties": false, "required": ["standing"],
      "properties": { "standing": { "$ref": "#/$defs/standing" }, "input": { "$ref": "#/$defs/count" }, "output": { "$ref": "#/$defs/count" } }
    },
    "cache": {
      "type": "object", "additionalProperties": false, "required": ["standing"],
      "properties": { "standing": { "$ref": "#/$defs/standing" }, "read_input": { "$ref": "#/$defs/count" }, "creation_input": { "$ref": "#/$defs/count" }, "output": { "$ref": "#/$defs/count" } }
    },
    "usage_classes": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["class", "quantity", "unit", "standing"],
        "properties": { "class": { "$ref": "#/$defs/ref" }, "quantity": { "$ref": "#/$defs/count" }, "unit": { "$ref": "#/$defs/ref" }, "standing": { "$ref": "#/$defs/standing" } }
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false, "required": ["latency"],
      "properties": { "started_at": { "$ref": "#/$defs/timestamp" }, "completed_at": { "$ref": "#/$defs/timestamp" }, "latency": { "$ref": "#/$defs/measurement" } }
    },
    "cost": {
      "type": "object", "additionalProperties": false, "required": ["standing"],
      "properties": {
        "standing": { "$ref": "#/$defs/standing" }, "amount": { "type": "number", "minimum": 0 }, "currency": { "$ref": "#/$defs/ref" },
        "pricing_basis": {
          "type": "object", "additionalProperties": false, "required": ["source_ref", "revision", "effective_at"],
          "properties": { "source_ref": { "$ref": "#/$defs/ref" }, "revision": { "$ref": "#/$defs/ref" }, "effective_at": { "$ref": "#/$defs/timestamp" } }
        }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["state", "standing"],
      "properties": { "state": { "enum": ["completed", "partial", "failed", "cancelled", "interrupted", "unknown"] }, "standing": { "$ref": "#/$defs/standing" }, "reason": { "$ref": "#/$defs/ref" } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["reporter_ref", "native_event_ref", "native_schema", "observed_at", "raw_evidence_refs"],
      "properties": {
        "reporter_ref": { "$ref": "#/$defs/ref" }, "native_event_ref": { "$ref": "#/$defs/ref" },
        "native_request_ref": { "$ref": "#/$defs/ref" }, "native_schema": { "$ref": "#/$defs/ref" },
        "observed_at": { "$ref": "#/$defs/timestamp" }, "raw_evidence_refs": { "$ref": "#/$defs/nonEmptyRefs" }
      }
    },
    "provider_facts": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "count": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "standing": { "enum": ["provider-reported", "observed", "normalized-from-native", "derived", "estimated", "unavailable", "not-reported"] },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["standing"],
      "properties": { "standing": { "$ref": "#/$defs/standing" }, "ref": { "$ref": "#/$defs/ref" }, "name": { "$ref": "#/$defs/ref" }, "revision": { "$ref": "#/$defs/ref" }, "variant": { "$ref": "#/$defs/ref" } }
    },
    "measurement": {
      "type": "object", "additionalProperties": false, "required": ["standing"],
      "properties": { "standing": { "$ref": "#/$defs/standing" }, "milliseconds": { "type": "number", "minimum": 0 } }
    }
  }
}
