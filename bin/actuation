            ),
            staged: stagedAxis(provenance("actuation:harness:catalog", PATH.catalog, observedAtMs)),
            expected_effect: expectedEffect()
          },
          mutable: false,
          native_path: "actuation harness detect (no mutation disclosed)",
          bootstrap: false,
