  oneOf(INJECTION_CHANNELS, channel.kind, "injection_channel.kind");
  ref6(channel.mechanism, "injection_channel.mechanism");
  ref6(channel.notes, "injection_channel.notes", { optional: true });
  const blocking = record3(capability.blocking_semantics, "HarnessCapability.blocking_semantics");
  oneOf(BLOCKING_KINDS, blocking.kind, "blocking_semantics.kind");
  ref6(blocking.notes, "blocking_semantics.notes", { optional: true });
  const wake = record3(capability.wake_capability, "HarnessCapability.wake_capability");
  oneOf(WAKE_KINDS, wake.kind, "wake_capability.kind");
  ref6(wake.notes, "wake_capability.notes", { optional: true });
  if (wake.kind === "immediate-wake" && !wake.notes) {
    throw new TypeError("wake_capability.kind immediate-wake requires notes naming the listener that makes it true");
  }
  validateSeam(capability.install_seam, "HarnessCapability.install_seam");
  validateSeam(capability.uninstall_seam, "HarnessCapability.uninstall_seam");
  if (capability.model_dispatch != null) {
    validateModelDispatch(capability.model_dispatch, "HarnessCapability.model_dispatch");
  }
  const provenance2 = record3(capability.provenance, "HarnessCapability.provenance");
  ref6(provenance2.authored_by, "provenance.authored_by");
  stringArray2(provenance2.source_refs, "provenance.source_refs");
  if (!Array.isArray(provenance2.source_refs) || provenance2.source_refs.length === 0) {
    throw new TypeError("provenance.source_refs must cite at least one source");
  }
  return capability;
}
