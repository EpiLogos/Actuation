var AGENCY_CONTRACT_VERSION = "actuation.agency/v1";
var DETERMINATION_KINDS = /* @__PURE__ */ new Set([
  "self-differentiation",
  "delegation",
  "derivation",
  "federation"
]);
var RETURN_MODES = /* @__PURE__ */ new Set(["required", "optional", "autonomous-termination"]);
var RECOGNITION_STATES = /* @__PURE__ */ new Set(["pending", "recognised", "rejected"]);
var MUTATION_STATES = /* @__PURE__ */ new Set(["not-applied", "applied"]);
var METAGENCY_OPERATIONS = /* @__PURE__ */ new Set([
  "determine-agency",
  "configure-agency",
